  "servers": [
    {
      "url": "https://api.prp.icel.site/api/v2"
    }
  ],
  "components": {
    "schemas": {
      "model.AllChartsResponse": {
        "type": "object",
        "properties": {
          "charts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/model.ChartWithScore"
            }
          },
          "nickname": {
            "type": "string"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "model.Chart": {
        "type": "object",
        "properties": {
          "created_at": {
            "type": "string"
          },
          "difficulty": {
            "allOf": [
              {
                "$ref": "#/components/schemas/model.Difficulty"
              }
            ],
            "example": "massive"
          },
          "fitting_level": {
            "type": "number",
            "nullable": true
          },
          "id": {
            "type": "integer"
          },
          "level": {
            "type": "number"
          },
          "level_design": {
