            }
          },
          {
            "description": "Page index (scope=all only)",
            "name": "page_index",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "description": "Sort by (rating, score, record_time)",
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "rating"
            }
          },
          {
            "description": "Order (desc or asc)",
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
