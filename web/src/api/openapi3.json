  "paths": {
    "/records/{username}": {
      "get": {
        "description": "Retrieve play records for a user based on scope (b50, best, all, all-charts)\nB50 selects the highest rating or fitting_rating per season before applying order; best supports fitting_rating sorting before pagination. Fitting ratings use the published fitting level, falling back to the official level. The rating field always retains the official rating.",
        "tags": [
          "record"
        ],
        "summary": "Get play records",
        "parameters": [
          {
            "description": "Username",
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Scope (b50, best, all, all-charts)",
            "name": "scope",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "b50"
            }
          },
          {
            "description": "Underflow for b50",
            "name": "underflow",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 0
            }
          },
          {
            "description": "Page size",
            "name": "page_size",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 50
            }
          },
          {
            "description": "Page index",
            "name": "page_index",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "description": "Sort by: rating or fitting_rating for b50; rating, fitting_rating, score or record_time for best; rating, score or record_time for all",
            "name": "sort_by",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "rating"
            }
          },
          {
            "description": "Order (desc or asc); b50 membership always uses the highest ratings",
            "name": "order",
            "in": "query",
            "schema": {
              "type": "string",
              "default": "desc"
            }
          },
          {
            "description": "Minimum chart level (inclusive)",
            "name": "min_level",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "description": "Maximum chart level (inclusive)",
            "name": "max_level",
            "in": "query",
            "schema": {
              "type": "number"
            }
          },
          {
            "description": "Filter by difficulty (detected, invaded, massive, reboot)",
            "name": "difficulty",
            "in": "query",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "description": "Filter by season: true = new (B15), false = old (B35)",
            "name": "b15",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "all-charts scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/model.AllChartsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/model.Response"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/model.Response"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/model.Response"
                }
              }
            }
          }
        }
      },
      "post": {
        "description": "Batch upload play records for a user",
        "tags": [
          "record"
        ],
        "summary": "Upload play records",
        "parameters": [
          {
            "description": "Username",
            "name": "username",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/request.BatchCreatePlayRecordRequest"
              }
            }
          },
          "description": "Play records upload info",
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/model.PlayRecord"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/model.Response"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/model.Response"
                }
              }
            }
          }
        }
      }
    },
    "/records/{username}/chart/{chart_addr}": {
